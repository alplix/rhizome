{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rhizome",
  "version": "0.5.0",
  "identifier": "org.rhizome.irc",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Alp",
    "copyright": "Copyright \u00a9 2026 Alp. GPL-3.0-or-later.",
    "shortDescription": "A modern IRC client for developer networks",
    "longDescription": "Rhizome is a modern, private, local-first IRC client for developer networks such as Libera.Chat, OFTC and hackint.",
    "category": "SocialNetworking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {}
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
